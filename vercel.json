{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",

  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.divinginasia.com" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.divnginasia.com" }],
      "destination": "/admin",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/functions/v1/page_content", "destination": "https://wulgixdyofyfdwcymwec.functions.supabase.co/page_content" },
    { "source": "/wp-json/:path*", "destination": "https://lightsalmon-dinosaur-377714.hostingersite.com/wp-json/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
