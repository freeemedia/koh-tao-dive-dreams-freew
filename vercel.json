{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "regions": ["fra1"]
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/booking-form",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking-form.html",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking.html",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/bookingform.html",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booknow.html",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/booking-form-standalone.html",
      "destination": "/booking",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/functions/v1/page_content", "destination": "https://wulgixdyofyfdwcymwec.functions.supabase.co/page_content" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
