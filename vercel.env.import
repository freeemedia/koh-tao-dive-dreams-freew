# Vercel backend env import file
# Fill in secret values before import.

# Core backend identity
SITE_NAME=Lembongan Watersports
SITE_DOMAIN=lembonganwatersports.com
SITE_URL=https://www.lembonganwatersports.com
SITE_LOCATION=Nusa Lembongan, Bali, Indonesia

# Primary MySQL database (source of truth)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Admin auth tokens
ADMIN_BOOKINGS_VIEW_TOKEN=
ADMIN_VIEW_TOKEN=
ADMIN_LOGIN_TOKEN=
ADMIN_API_TOKEN=

# WordPress integration (admin subdomain)
ADMIN_PANEL_URL=https://admin.lembonganwatersports.com/wp-admin/admin.php?page=ktd-dashboard
WP_BOOKING_URL=https://admin.lembonganwatersports.com
WP_CONTENT_URL=https://admin.lembonganwatersports.com
WP_BOOKING_API_KEY=
ENABLE_WP_BOOKING_MIRROR=false
# Optional: force bookings endpoint to use WordPress as primary storage.
# BOOKING_STORAGE=wordpress

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=confirmed@divinginasia.com
RESEND_BOOKING_TO_EMAIL=bookings@divinginasia.com

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional services
DROPBOX_ACCESS_TOKEN=

# Optional app auth settings
VITE_ADMIN_EMAILS=
ADMIN_EMAILS=
