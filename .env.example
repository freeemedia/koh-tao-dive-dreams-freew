# Optional API base URL for frontend (leave empty for same-origin)
VITE_API_BASE_URL=

# Site branding and domain
SITE_NAME=Lembongan Watersports
SITE_DOMAIN=lembonganwatersports.com
SITE_URL=https://www.lembonganwatersports.com
SITE_LOCATION=Nusa Lembongan, Bali, Indonesia
SITE_LOGO_URL=
ADMIN_PANEL_URL=https://admin.lembonganwatersports.com/wp-admin/admin.php?page=ktd-dashboard
VITE_SITE_NAME=Lembongan Watersports
VITE_SITE_DOMAIN=lembonganwatersports.com
VITE_SITE_LOCATION=Nusa Lembongan, Bali, Indonesia
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
WHATSAPP_NUMBER=
WHATSAPP_DISPLAY=

# Hostinger MySQL (primary booking database)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Optional WordPress sync/content endpoints
ENABLE_WP_BOOKING_MIRROR=false
# Set to wordpress to force bookings API to use WP as primary storage.
# Allowed values: wordpress | wp
# BOOKING_STORAGE=
WP_BOOKING_URL=https://admin.lembonganwatersports.com
WP_BOOKING_API_KEY=
WP_CONTENT_URL=https://admin.lembonganwatersports.com

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=confirmed@divinginasia.com
RESEND_BOOKING_TO_EMAIL=bookings@divinginasia.com

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dropbox gallery
DROPBOX_ACCESS_TOKEN=


# Existing Supabase vars can remain if you're still using Supabase auth pages
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin authorization (comma-separated emails).
# Set BOTH so frontend route/login checks and backend API checks agree.
# Example:
# VITE_ADMIN_EMAILS=admin@yourdomain.com
# ADMIN_EMAILS=admin@yourdomain.com
VITE_ADMIN_EMAILS=
ADMIN_EMAILS=
