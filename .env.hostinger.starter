# Hostinger starter environment template
NODE_ENV=production
PORT=3001

# Booking storage provider: mysql | wordpress | supabase
DB_PROVIDER=mysql
ALLOW_WORDPRESS_BOOKINGS=true

# MySQL
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# WordPress booking API
WP_BOOKING_URL=https://admin.yourdomain.com
WP_BOOKING_API_KEY=your_wp_booking_api_key

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Email notifications
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=confirmed@yourdomain.com
RESEND_BOOKING_TO_EMAIL=bookings@yourdomain.com

# Admin access
ADMIN_BOOKINGS_API_URL=https://www.yourdomain.com/api/admin-bookings
ADMIN_BOOKINGS_VIEW_TOKEN=your_admin_view_token
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_PASSWORD=your_admin_password

# Optional legacy keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
